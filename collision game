import pygame as p
import random as r

screen_height, screen_width = 400, 500
movement_speed = 5
font_size = 72

p.init()

background_image = p.image.load(r"C:\Users\angsh\OneDrive\Pictures\133858812639136875.jpg")
background_image = p.transform.scale(
    background_image,
    (screen_width, screen_height)
)

font = p.font.SysFont("Times New Roman", font_size)

class sprite(p.sprite.Sprite):

    def __init__(self, colour, height, width):
        super().__init__()

        self.image = p.Surface([width, height])
        self.image.fill(p.Color("dodgerblue"))
        p.draw.rect(self.image, colour, p.Rect(0, 0, width, height))
        self.rect = self.image.get_rect()

    def move(self, x_change, y_change):

        self.rect.x = max(
            min(self.rect.x + x_change,
                screen_width - self.rect.width),
            0
        )

        self.rect.y = max(
            min(self.rect.y + y_change,
                screen_height - self.rect.height),
            0
        )

screen = p.display.set_mode((screen_width, screen_height))
p.display.set_caption("Sprite Collision")

all_sprites = p.sprite.Group()

sprite1 = sprite(p.Color("black"),40, 40)
sprite1.rect.x = r.randint(0, screen_width - sprite1.rect.width)
sprite1.rect.y = r.randint(0, screen_height - sprite1.rect.height)

all_sprites.add(sprite1)

sprite2 = sprite(p.Color("blue"), 40, 40)
sprite2.rect.x = r.randint(0, screen_width - sprite2.rect.width)
sprite2.rect.y = r.randint(0, screen_height - sprite2.rect.height)

all_sprites.add(sprite2)

running = True
won = False

clock = p.time.Clock()

while running:

    for event in p.event.get():

        if event.type == p.QUIT:
            running = False

        if event.type == p.KEYDOWN and event.key == p.K_x:
            running = False

    if not won:

        keys = p.key.get_pressed()

        x_change = (
            keys[p.K_RIGHT] - keys[p.K_LEFT]
        ) * movement_speed

        y_change = (
            keys[p.K_DOWN] - keys[p.K_UP]
        ) * movement_speed

        sprite1.move(x_change, y_change)

        if sprite1.rect.colliderect(sprite2.rect):
            all_sprites.remove(sprite1,sprite2)
            won = True
            

    screen.blit(background_image, (0, 0))

    all_sprites.draw(screen)

    if won:

        win_text = font.render(
            "You Win",
            True,
            p.Color("black")
        )

        screen.blit(
            win_text,
            (
                (screen_width - win_text.get_width()) // 2,
                (screen_height - win_text.get_height()) // 2
            )
        )

    p.display.flip()
    clock.tick(90)

p.quit()