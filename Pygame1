import pygame as pg

pg.init()

screen = pg.display.set_mode((400,500))

done = False

while not done:
    for event in pg.event.get():
        if event.type == pg.QUIT:
            pg.quit()
            done = True
    pg.draw.rect(screen,(0,125,255),pg.Rect(30,30,60,60))
    pg.draw.circle(screen,(255,255,255),(300,200),50)
    pg.draw.circle(screen,(255,255,255),(150,200),50,3)
    pg.display.flip()
